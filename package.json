{
  "name": "iqvoc_inflectionals",
  "version": "2.11.4",
  "description": "Inflectionals extension for iQvoc vocabulary management system built on the Semantic Web",
  "main": "app/javascript/manifest.js",
  "files": [
    "app/assets/**/*",
    "app/javascript/**/*"
  ],
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innoq/iqvoc_inflectionals.git"
  },
  "author": "",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/innoq/iqvoc_inflectionals/issues"
  },
  "homepage": "https://github.com/innoq/iqvoc_inflectionals#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.108.1"
  },
  "dependencies": {
    "iqvoc": "github:innoq/iqvoc",
    "iqvoc_skosxl": "github:innoq/iqvoc_skosxl"
  }
}
